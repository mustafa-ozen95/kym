#!/bin/bash
# =============================================================================
#  Konteyner başlatıcı
# =============================================================================
#  Sırayla: dizinler → yapılandırma → OAuth anahtarları → veritabanı → göçler
#  → süreç yöneticisi.
#
#  Veritabanı ve redis AYRI servislerdir (docker-compose.yml: db, redis);
#  imajda ikisi de yok. Adresleri ortamdan gelir (DB_*, REDIS_*), varsayılan
#  compose'taki servis adları. Merkez yalnız HTTP dinler (80): TLS'i önündeki
#  vekil bitirir.
# =============================================================================
set -euo pipefail

APP_ROOT=/uygulama
PHP=/usr/bin/php

bilgi() { printf '\033[1;34m[kimlik]\033[0m %s\n' "$*"; }
uyari() { printf '\033[1;33m[kimlik]\033[0m %s\n' "$*" >&2; }
hata()  { printf '\033[1;31m[kimlik]\033[0m %s\n' "$*" >&2; exit 1; }

# -----------------------------------------------------------------------------
#  1. Çalışma dizinleri
# -----------------------------------------------------------------------------
mkdir -p /run/php
chown kimlik:kimlik /run/php

# Çalışma yolları İngilizce adlara geçti: eski hacimdeki adlar açılışta taşınır
# (dizinler OLUŞTURULMADAN önce; yeni ad varsa dokunulmaz, uyarı yazılır;
# bkz. dc-paths).
/usr/local/bin/dc-paths "${APP_ROOT}/storage/app" \
    veritabani=database \
    database/baglanti.json=database/connection.json \
    database/durum.json=database/state.json \
    guncelleme=update \
    update/durum.json=update/state.json \
    ilk-parola.txt=initial-password.txt

mkdir -p "${APP_ROOT}"/storage/{app,logs} \
         "${APP_ROOT}"/storage/framework/{cache/data,sessions,views} \
         "${APP_ROOT}"/bootstrap/cache
chown -R kimlik:kimlik "${APP_ROOT}"/storage "${APP_ROOT}"/bootstrap/cache


# Sertifika sekmesinin istek dizini: panel istek.json bırakır, sunucudaki ajan
# okur. Dizin root'a ait gelirse (yeni hacim, chown'suz açılmış host dizini)
# panel yazamaz ve sekme istek bırakamaz. Bağlı
# değilse dokunulmaz.
if [ -d /etc/dc/sertifika-panel ]; then
    chown kimlik:kimlik /etc/dc/sertifika-panel 2>/dev/null && chmod 0750 /etc/dc/sertifika-panel \
        || uyari "/etc/dc/sertifika-panel yazılabilir değil (salt okunur bağlanmış olabilir); Sertifika sekmesi istek bırakamaz."
fi

# -----------------------------------------------------------------------------
#  2. Varsayılanlar
# -----------------------------------------------------------------------------
#  İmajda .env DOSYASI YOKTUR; Laravel ayarları doğrudan ortamdan okur.
#  Buradaki her değer ortamla (docker-compose.yml, .env ya da platformun
#  değişken ekranı) ezilebilir.
: "${APP_NAME:=Kimlik Merkezi}"
: "${APP_ENV:=production}"
: "${APP_DEBUG:=false}"
: "${APP_LOCALE:=tr}"
: "${APP_TIMEZONE:=Europe/Istanbul}"
: "${LOG_CHANNEL:=stderr}"

: "${DB_CONNECTION:=mysql}"
: "${DB_HOST:=db}"
: "${DB_PORT:=3306}"
: "${DB_DATABASE:=kimlik}"
: "${DB_USERNAME:=kimlik}"

# Veritabanı OTURUMUNUN saat dilimi: konteynerin saati (TZ). MariaDB TIMESTAMP
# sütununu oturumun dilimine çevirerek okur ve yazar. İç veritabanı konteynerin
# saatinde çalışır, uzak ya da yönetilen bir sunucu çoğu zaman UTC'de: dilim
# eşitlenmezse taşınan her kayıt 3 saat kaymış okunur ve denetim zinciri kırık
# görünür. Türkiye'de yaz saati yok; sabit fark yeter, sunucuda dilim tablosu
# gerekmez.
: "${DB_TIMEZONE:=$(date +%:z)}"

# Önbellek, oturum ve kuyruk REDIS'te durur (compose: redis servisi).
#
# Veritabanı sürücüsü her istekte SQL yazıyordu: oturum tablosu merkezin en
# çok yazılan tablosu hâline geliyor, yedeği de gereksiz yere şişiriyordu.
: "${REDIS_CLIENT:=phpredis}"
: "${REDIS_HOST:=redis}"
: "${CACHE_STORE:=redis}"
: "${SESSION_DRIVER:=redis}"
: "${QUEUE_CONNECTION:=redis}"
: "${FILESYSTEM_DISK:=local}"

# ADMIN_EMAIL'in VARSAYILANI YOK: bir varsayılan adres, kurulumu yapan
# kişinin sahip olmadığı bir hesabın açılması demek olurdu. Verilmezse
# hesap hiç açılmaz (aşağıya bakın).
# Konteyner kurulumunda ÖRNEK VERİ KAPALI: yerleşik salonlar ve admin dışındaki
# roller yazılmaz. Yeni bir kuruluma başkasının örnek yapısını yazmak yanlış
# olurdu; kurulumu yapan kendi salonlarını ve rollerini panelden açar.
: "${SAMPLE_DATA:=false}"

: "${ADMIN_NAME:=Sistem Yöneticisi}"

# Oturum çerezi varsayılan olarak Secure'dur: merkez TLS arkasında durur.
: "${SESSION_SECURE_COOKIE:=true}"

export APP_NAME APP_ENV APP_DEBUG APP_LOCALE APP_TIMEZONE LOG_CHANNEL \
       DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_TIMEZONE \
       CACHE_STORE SESSION_DRIVER QUEUE_CONNECTION FILESYSTEM_DISK \
       REDIS_CLIENT REDIS_HOST REDIS_PORT REDIS_PASSWORD \
       SESSION_SECURE_COOKIE ADMIN_EMAIL ADMIN_NAME SAMPLE_DATA THEME_COOKIE_DOMAIN

# -----------------------------------------------------------------------------
#  3. APP_KEY
# -----------------------------------------------------------------------------
#  İki adım gizli anahtarları (`totp_secret`) ve kurtarma kodları bu anahtarla
#  şifrelenir. Kaybolursa iki adım kurmuş HERKES panelinden kilitlenir.
KEY_FILE="${APP_ROOT}/storage/app/app-key.txt"

if [[ -z "${APP_KEY:-}" ]]; then
    if [[ -s "${KEY_FILE}" ]]; then
        APP_KEY="$(cat "${KEY_FILE}")"
        export APP_KEY
    else
        APP_KEY="base64:$(head -c 32 /dev/urandom | base64)"
        export APP_KEY

        printf '%s' "${APP_KEY}" > "${KEY_FILE}"
        chmod 0600 "${KEY_FILE}"
        chown kimlik:kimlik "${KEY_FILE}"

        # Anahtarın KENDİSİ günlüğe yazılmaz: konteyner günlükleri (docker
        # logs, günlük toplayıcılar) anahtarı okuyabilecek herkesin önüne
        # düşer ve yedeklerde/ekran görüntülerinde kalır. Anahtar zaten 0600
        # bir dosyada; burada yalnızca nerede olduğu söylenir.
        uyari "════════════════════════════════════════════════════════════════"
        uyari " APP_KEY verilmemişti, üretildi ve saklandı."
        uyari ""
        uyari " Dosya: storage/app/app-key.txt (hacimde durur, yalnızca kimlik"
        uyari " kullanıcısı okur). Okumak için:"
        uyari "   docker exec <kapsayıcı> cat /uygulama/storage/app/app-key.txt"
        uyari ""
        uyari " YEDEKLEYİN — kaybolursa iki adım kurmuş herkes kilitlenir."
        uyari "════════════════════════════════════════════════════════════════"
    fi
fi

# -----------------------------------------------------------------------------
#  4. Paneldeki veritabanı ayarı (Ayarlar → Veritabanı)
# -----------------------------------------------------------------------------
#  Panelde uzak bir veritabanı tanımlandıysa bağlantı storage/app/database'de
#  şifreli durur ve yukarıdaki DB_* değerlerini EZER (bkz. ConnectionFile).
#
#  TAŞIMA BURADA YAPILIR, panel çalışmıyorken: kopya alınırken kimse yazmasın
#  diye. Panel isteği bırakıp konteyneri yeniden başlatır (dc-restart);
#  bu açılış ORTAMIN VERDİĞİ veritabanını (DB_*, çoğunlukla compose'taki db
#  servisi) uzak hedefe kopyalar, tablo ve satır sayılarını iki tarafta
#  karşılaştırır ve uzak veritabanıyla devam eder. Bir adım tutmazsa taşıma
#  "basarisiz" yazılır ve panel ortamın veritabanıyla açılır. Kaynağa
#  yazılmaz: taşıma anındaki hâliyle durur.
DB_STATE_DIR="${APP_ROOT}/storage/app/database"
DB_STAGE=""
DB_REASON=""
DB_SUMMARY=""
declare -A DB_CONN=()

vt() { gosu kimlik env APP_ROOT="${APP_ROOT}" "${PHP}" /usr/local/bin/dc-database "$@"; }

# Veritabanı bağlantıyı kabul edene kadar bekler (en çok ~3 dk). Seçenek
# dosyası ilk argüman: parola komut satırına girmez.
mariadb_bekle() {
    for _ in $(seq 1 90); do
        mariadb-admin "--defaults-extra-file=$1" --connect-timeout=2 ping --silent >/dev/null 2>&1 && return 0
        sleep 2
    done
    return 1
}

vt_ilk_satir() { head -n 1 "$1" 2>/dev/null | cut -c 1-300; }

# Bağlantıyı DB_CONN'e okur. Değerler base64 gelir: parolada tırnak, boşluk ya
# da satır sonu olabilir ve eval'siz taşımanın güvenli yolu bu.
vt_oku() {
    local satirlar satir
    satirlar="$(vt ortam)" || return 1
    while IFS= read -r satir; do
        [[ -n "${satir}" ]] && DB_CONN["${satir%%=*}"]="$(printf '%s' "${satir#*=}" | base64 -d)"
    done <<< "${satirlar}"
    [[ -n "${DB_CONN[DB_HOST]:-}" && -n "${DB_CONN[DB_DATABASE]:-}" ]]
}

vt_ortama_al() {
    DB_CONNECTION=mysql
    DB_HOST="${DB_CONN[DB_HOST]}"
    DB_PORT="${DB_CONN[DB_PORT]}"
    DB_DATABASE="${DB_CONN[DB_DATABASE]}"
    DB_USERNAME="${DB_CONN[DB_USERNAME]}"
    DB_PASSWORD="${DB_CONN[DB_PASSWORD]}"
    DB_URL=""
    export DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_URL
}

# Tablo başına kesin satır sayısı ("tablo sayı" satırları). Kopya sırasında
# panel kapalı olduğu için iki tarafın çıktısı BİREBİR aynı olmalı.
#
# Sıralama KABUKTA yapılır: MariaDB ile MySQL'in information_schema
# harmanlaması farklı ve ORDER BY "jobs" ile "job_batches"ı iki tarafta ters
# dizebilir (ör. MySQL 8.4); sayılar aynıyken kopya tutmadı sanılırdı.
vt_sayim() {
    local tablolar t n
    tablolar="$(mariadb "$@" -N -B -e "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE'")" || return 1
    for t in $(LC_ALL=C sort <<< "${tablolar}"); do
        n="$(mariadb "$@" -N -B -e "SELECT COUNT(*) FROM \`${t}\`")" || return 1
        printf '%s %s\n' "${t}" "${n}"
    done
}

vt_kopyala() {
    local kaynak_cnf=$1 cnf=$2 hata=$3 n kaynak hedef
    # Seçenek dosyası İLK argüman olmak zorunda (mariadb istemcisinin kuralı).
    local -a ic=("--defaults-extra-file=${kaynak_cnf}" --connect-timeout=10 "--database=${DB_DATABASE}")
    local -a uzak=("--defaults-extra-file=${cnf}" --connect-timeout=10 "--database=${DB_CONN[DB_DATABASE]}")

    # Kopya yalnızca tabloları taşır. Görünüm, yordam, tetikleyici ve olay
    # tanımlayan kullanıcıya bağlıdır ve hedefte ayrı yetki ister; bu panelde
    # yoklar, olursa eksik bir kopya yerine taşıma yapılmaz.
    n="$(mariadb "${ic[@]}" -N -B -e "SELECT
        (SELECT COUNT(*) FROM information_schema.views WHERE table_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.routines WHERE routine_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema = DATABASE())
      + (SELECT COUNT(*) FROM information_schema.events WHERE event_schema = DATABASE())" 2>"${hata}")" \
        || { DB_REASON="Mevcut veritabanı okunamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { DB_REASON="Mevcut veritabanında görünüm, yordam, tetikleyici ya da zamanlanmış olay var (${n}); bu taşıma onları kopyalamaz."; return 1; }

    n="$(mariadb "${uzak[@]}" -N -B -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()" 2>"${hata}")" \
        || { DB_REASON="Uzak veritabanına bağlanılamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ "${n}" == "0" ]] \
        || { DB_REASON="Uzak veritabanı boş değil (${n} tablo); üzerine yazılmaz."; return 1; }

    # --skip-add-locks: hedef kullanıcıdan LOCK TABLES yetkisi istenmesin.
    # --no-tablespaces: kaynak kullanıcıdan PROCESS yetkisi istenmesin.
    bilgi "Taşıma: kopyalanıyor..."
    if ! mariadb-dump "--defaults-extra-file=${kaynak_cnf}" --single-transaction --skip-add-locks --skip-triggers \
            --no-tablespaces --hex-blob --default-character-set=utf8mb4 "${DB_DATABASE}" 2>"${hata}" \
        | mariadb "${uzak[@]}" --default-character-set=utf8mb4 2>>"${hata}"; then
        DB_REASON="Kopya yarıda kaldı: $(vt_ilk_satir "${hata}") Uzak veritabanını boşaltıp yeniden deneyin."
        return 1
    fi

    bilgi "Taşıma: iki tarafta tablo ve satırlar sayılıyor..."
    kaynak="$(vt_sayim "${ic[@]}")" || { DB_REASON="Mevcut veritabanında sayım yapılamadı."; return 1; }
    hedef="$(vt_sayim "${uzak[@]}" 2>"${hata}")" || { DB_REASON="Uzak veritabanında sayım yapılamadı: $(vt_ilk_satir "${hata}")"; return 1; }
    [[ -n "${kaynak}" && "${kaynak}" == "${hedef}" ]] \
        || { DB_REASON="Kopya tutmadı: iki taraftaki tablo ya da satır sayıları farklı. Uzak veritabanını boşaltıp yeniden deneyin."; return 1; }

    DB_SUMMARY="$(awk '{ n++; s += $2 } END { printf "%d tablo, %d satır kopyalandı; iki tarafta sayılar aynı.", n, s }' <<< "${kaynak}")"
}

vt_tasi() {
    local kaynak_cnf=/run/dc-vt-kaynak.cnf cnf=/run/dc-vt-hedef.cnf hata=/run/dc-vt.hata sonuc=0

    vt_oku || { DB_REASON="Bağlantı dosyası okunamadı."; return 1; }
    if [[ "${DB_CONN[DB_HOST]}" == "${DB_HOST}" && "${DB_CONN[DB_PORT]}" == "${DB_PORT}" && "${DB_CONN[DB_DATABASE]}" == "${DB_DATABASE}" ]]; then
        DB_REASON="Hedef, panelin şu anki veritabanının kendisi (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
        return 1
    fi
    ( umask 077; vt ortam-istemci > "${kaynak_cnf}" && vt istemci > "${cnf}" ) \
        || { rm -f "${kaynak_cnf}" "${cnf}"; DB_REASON="Bağlantı dosyası okunamadı."; return 1; }

    bilgi "Taşıma: mevcut veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
    if mariadb_bekle "${kaynak_cnf}"; then
        vt_kopyala "${kaynak_cnf}" "${cnf}" "${hata}" || sonuc=1
    else
        DB_REASON="Mevcut veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."
        sonuc=1
    fi
    rm -f "${kaynak_cnf}" "${cnf}" "${hata}"
    return "${sonuc}"
}

# Bu açılış zaten istenen yeniden başlatmadır; kalmış bir istek (konteyner
# döngü görmeden durdurulduysa) bir kez daha boşuna başlatırdı.
rm -f "${DB_STATE_DIR}/restart"

if [[ -f "${DB_STATE_DIR}/state.json" ]]; then
    DB_STAGE="$(vt asama)" || hata "Veritabanı ayarı okunamadı (${DB_STATE_DIR}/state.json)."
fi

case "${DB_STAGE}" in
    tasiniyor|deneniyor)
        # Bir önceki açılış taşımanın ortasında kapandı (elle durdurma, elektrik).
        # Panel uzak veritabanına henüz yazmadı; ortamın veritabanıyla devam
        # etmek veri kaybettirmez.
        uyari "Önceki açılış veritabanı taşımasının ortasında kapanmış; ortamın veritabanıyla devam ediliyor."
        vt yaz basarisiz "Önceki açılış taşımanın ortasında kapandı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin."
        DB_STAGE=basarisiz
        ;;
    tasinacak)
        bilgi "Veritabanı uzak sunucuya taşınıyor..."
        vt yaz tasiniyor
        if vt_tasi; then
            vt yaz deneniyor "${DB_SUMMARY}"
            DB_STAGE=deneniyor
            bilgi "Taşıma: ${DB_SUMMARY}"
        else
            uyari "Taşıma yapılmadı: ${DB_REASON:-bilinmeyen sebep}"
            vt yaz basarisiz "${DB_REASON:-Bilinmeyen sebep.}"
            DB_STAGE=basarisiz
        fi
        ;;
esac

if [[ "${DB_STAGE}" == "deneniyor" || "${DB_STAGE}" == "etkin" ]]; then
    if [[ -z "${DB_CONN[DB_HOST]:-}" ]] && ! vt_oku; then
        # "etkin"de ortamın veritabanına DÖNÜLMEZ: taşıma anında donmuştu.
        [[ "${DB_STAGE}" == "etkin" ]] \
            && hata "Panel uzak veritabanında ama bağlantı dosyası okunamıyor (APP_KEY değişmiş ya da dosya silinmiş olabilir). Ortamın veritabanı taşıma anındaki hâliyle duruyor; kendiliğinden ona dönülmez."
        vt yaz basarisiz "Bağlantı dosyası okunamadı."
        DB_STAGE=basarisiz
    else
        vt_ortama_al
        bilgi "Veritabanı: paneldeki ayar (${DB_HOST}:${DB_PORT}/${DB_DATABASE})."
    fi
fi

# -----------------------------------------------------------------------------
#  5. OAuth imza anahtarları
# -----------------------------------------------------------------------------
#  Passport jetonları BU ÖZEL ANAHTARLA imzalar. Her açılışta yenisi
#  üretilseydi, yeniden başlatmanın ertesinde dağıtılmış bütün jetonlar
#  geçersiz olurdu: bağlı panellerin kullanıcıları toptan dışarı düşerdi.
#
#  Bu yüzden anahtarlar HACİMDE durur ve içerikleri ortam değişkeni olarak
#  geçirilir (config/passport.php → PASSPORT_PRIVATE_KEY). Dosya yolu yerine
#  içerik geçirilmesinin sebebi: uygulama dizini imajın parçası, hacim değil.
OAUTH_DIR="${APP_ROOT}/storage/app/oauth"
mkdir -p "${OAUTH_DIR}"

if [[ ! -s "${OAUTH_DIR}/oauth-private.key" ]]; then
    bilgi "OAuth imza anahtarları üretiliyor..."
    openssl genrsa -out "${OAUTH_DIR}/oauth-private.key" 4096 2>/dev/null
    openssl rsa -in "${OAUTH_DIR}/oauth-private.key" \
        -pubout -out "${OAUTH_DIR}/oauth-public.key" 2>/dev/null
fi

chown -R kimlik:kimlik "${OAUTH_DIR}"
chmod 0600 "${OAUTH_DIR}/oauth-private.key"
chmod 0644 "${OAUTH_DIR}/oauth-public.key"

PASSPORT_PRIVATE_KEY="$(cat "${OAUTH_DIR}/oauth-private.key")"
PASSPORT_PUBLIC_KEY="$(cat "${OAUTH_DIR}/oauth-public.key")"
export PASSPORT_PRIVATE_KEY PASSPORT_PUBLIC_KEY

# -----------------------------------------------------------------------------
#  6. Veritabanını bekle
# -----------------------------------------------------------------------------
#  compose'taki db servisi ilk açılışta veri dizinini kurarken birkaç saniye
#  bağlantı kabul etmez; uzak sunucu ağ ya da bakım yüzünden geç gelebilir.
#  Gelmezse merkez açılmaz (çıkış kodu yeniden başlatır): boş bir SQLite'a ya
#  da yanlış yere düşmekten iyidir.
if [[ -z "${DB_PASSWORD:-}" ]]; then
    hata "DB_PASSWORD verilmedi. Veritabanının parolası ortamdan gelir (bkz. .env.example)."
fi
DB_WAIT_CNF=/run/dc-vt-bekle.cnf
( umask 077; vt ortam-istemci > "${DB_WAIT_CNF}" ) || hata "Veritabanı bağlantısı hazırlanamadı."
bilgi "Veritabanı bekleniyor (${DB_HOST}:${DB_PORT})..."
mariadb_bekle "${DB_WAIT_CNF}" || { rm -f "${DB_WAIT_CNF}"; hata "Veritabanına (${DB_HOST}:${DB_PORT}) bağlanılamadı."; }
rm -f "${DB_WAIT_CNF}"

# -----------------------------------------------------------------------------
#  7. Göçler ve önbellek
# -----------------------------------------------------------------------------
#  --isolated kilidi ÖNBELLEĞE yazılır ve önbellek veritabanındadır: göçler
#  koşmadan `cache_locks` tablosu HENÜZ YOK. İlk açılışta bu, göçün kendisini
#  "Table 'cache_locks' doesn't exist" ile düşürüyordu — tavuk-yumurta.
#
#  Kilit bu tek komut için DOSYA önbelleğine alınır: hem tabloya ihtiyaç
#  kalmaz hem koruma durur (aynı hacmi paylaşan ikinci bir örnek göçü ikinci
#  kez koşturamaz).
#
#  Önceki açılışın yapılandırma önbelleği SİLİNİR: konteyner yeniden
#  başladığında bootstrap/cache yerinde kalıyor ve Laravel ortamı değil onu
#  okuyor. Veritabanı taşımasından sonra göçler eski bağlantıya koşardı.
rm -f "${APP_ROOT}/bootstrap/cache/config.php"

bilgi "Göçler çalıştırılıyor..."
if [[ "${DB_STAGE}" == "deneniyor" ]]; then
    # Uzak veritabanıyla ilk açılış: göçler koşmazsa taşıma geri alınır.
    # Panel bu veritabanına henüz hiç yazmadı; ortamın veritabanına dönmek
    # veri kaybettirmez. Çıkış kodu yeniden başlatmayı tetikler, bir sonraki
    # açılış "basarisiz"ı görüp ortamın veritabanıyla açılır.
    if ! gosu kimlik env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated; then
        vt yaz basarisiz "Uzak veritabanıyla ilk açılışta göçler koşmadı; panel ortamın veritabanıyla açıldı. Uzak veritabanını boşaltıp yeniden deneyin." || true
        hata "Uzak veritabanında göçler koşmadı; taşıma geri alındı, panel ortamın veritabanıyla yeniden açılacak."
    fi
    vt yaz etkin
    bilgi "Veritabanı taşıması tamamlandı: panel artık uzak veritabanında."
else
    gosu kimlik env CACHE_STORE=file "${PHP}" artisan migrate --force --isolated
fi

# İlk yönetici YALNIZCA kullanıcı tablosu boşken oluşturulur; var olan bir
# kuruluma dokunulmaz. SystemSeeder BİLEREK çağrılmaz — örnek kutucukları yeni
# bir kuruluma yazmak yanlış olurdu.
if [[ "$(gosu kimlik "${PHP}" artisan tinker --execute='echo App\Models\User::query()->count();' 2>/dev/null | tail -1)" == "0" ]]; then
    # Hesap HER ZAMAN açılır — kimsenin giremediği bir panel işe yaramaz.
    # Kurulum betiği ad, adres ve parolayı zaten soruyor; bunlar yalnızca
    # doğrudan `docker compose up` ile gelinirse devreye girer:
    #   * adres verilmediyse .local bir adres kullanılır (hiçbir yere yönlenmez),
    #   * parola verilmediyse RASTGELE üretilir ve bir kez gösterilir.
    # Sabit bir parola konulsaydı imajı indiren herkeste aynı giriş olurdu;
    # asıl tehlike adresin değil, parolanın paylaşılmasıdır.
    if [[ -z "${ADMIN_EMAIL:-}" ]]; then
        ADMIN_EMAIL="admin@kimlik.local"
        export ADMIN_EMAIL
        uyari "ADMIN_EMAIL verilmedi; admin@kimlik.local kullanılıyor."
        uyari "Değiştirmek: panelde Hesap → Profil, ya da admin:add"
    fi

    URETILDI=0

    if [[ -z "${ADMIN_PASSWORD:-}" ]]; then
        # Sabit bir varsayılan parola KONULMAZ: imaj herkese aynı, parola
        # herkese aynı olurdu.
        ADMIN_PASSWORD="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | head -c 20)"
        export ADMIN_PASSWORD
        URETILDI=1
    fi

    bilgi "İlk yönetici oluşturuluyor: ${ADMIN_EMAIL}"
    gosu kimlik "${PHP}" artisan db:seed --force --class=Database\\Seeders\\FirstAdminSeeder

    if [[ "${URETILDI}" == "1" ]]; then
        INITIAL_PASSWORD_FILE="${APP_ROOT}/storage/app/initial-password.txt"
        printf '%s\n%s\n' "${ADMIN_EMAIL}" "${ADMIN_PASSWORD}" > "${INITIAL_PASSWORD_FILE}"
        chmod 0600 "${INITIAL_PASSWORD_FILE}"
        chown kimlik:kimlik "${INITIAL_PASSWORD_FILE}"

        uyari "════════════════════════════════════════════════════════════════"
        uyari " İlk yönetici parolası ÜRETİLDİ:"
        uyari ""
        # Parolanın kendisi günlüğe yazılmaz (bkz. APP_KEY notu yukarıda);
        # dosya 0600 ve hacimde durur.
        uyari "   e-posta: ${ADMIN_EMAIL}"
        uyari "   parola : storage/app/initial-password.txt dosyasında (2. satır). Okumak için:"
        uyari "     docker exec <kapsayıcı> cat /uygulama/storage/app/initial-password.txt"
        uyari ""
        uyari " Giriş yapıp parolayı değiştirdikten sonra o dosyayı SİLİN."
        uyari "════════════════════════════════════════════════════════════════"
    fi
fi

bilgi "Önbellekler üretiliyor..."
gosu kimlik "${PHP}" artisan optimize

bilgi "Merkez hazır."
exec "$@"
