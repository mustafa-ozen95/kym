<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Dil SABİTLENİR. Doğrulama mesajlarının Türkçeliğini sınayan test,
            ortamdaki APP_LOCALE'e bağlı kalınca makineden makineye farklı
            sonuç verirdi.
        -->
        <env name="APP_LOCALE" value="tr"/>
        <!--
            Testler üretim önbelleğini KULLANMAZ.

            bootstrap/cache/config.php varken (üretimde vardır) test koşusu o
            dosyayı okur ve buradaki değerlerin hiçbiri geçerli olmaz: oturum
            sürücüsü redis, çerez Secure, veritabanı MySQL... Var olmayan bir
            yol vererek çerçeve önbelleği yok sayar.
        -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events.testing.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Test koşusu ÜRETİM GÜNLÜĞÜNE YAZMASIN.

            Testler bilerek hata üretir (merkez erişilemiyor, yetki yok);
            bunlar storage/logs/laravel.log içine düşerse gerçek bir üretim
            hatasını aramak samanlıkta iğne aramaya döner.
        -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
